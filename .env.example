# GitHub Pages static export. Leave GITHUB_PAGES unset for local builds.
GITHUB_PAGES=
NEXT_PUBLIC_SITE_URL=

# Admin gate (static export — not a real server auth). Default: changeme
NEXT_PUBLIC_ADMIN_PASSWORD=changeme

# Stripe stubs only — test mode. This static export does not charge cards.
# Do not commit live keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
