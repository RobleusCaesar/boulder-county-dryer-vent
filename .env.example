# GitHub Pages static export. Leave GITHUB_PAGES unset for local builds.
GITHUB_PAGES=
NEXT_PUBLIC_SITE_URL=

# Admin gate (static export — not a real server auth). Default: changeme
NEXT_PUBLIC_ADMIN_PASSWORD=changeme

# Stripe stubs only — test mode. This static export does not charge cards.
# Do not commit live keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Payment Links (static Pages–safe). Leave empty = live stub unchanged.
# Set at build time only after Rob banks Stripe + written Ava/Rob go-live.
# Example: https://buy.stripe.com/xxxx
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_STANDARD=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_COMPLEX=
